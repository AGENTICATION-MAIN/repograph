# AegisKernel Environment Configuration Example

# Server Configuration
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_ENV=development
AEGIS_LOG_LEVEL=INFO

# Cryptographic Security
# REQUIRED IN PRODUCTION: Replace with a 32+ character high-entropy secret
AEGIS_SECRET_KEY=change-this-to-a-cryptographically-secure-random-32-byte-secret

# Kernel Invariant Enforcement
AEGIS_STRICT_INVARIANTS=true
AEGIS_TAINT_TRACKING=true
AEGIS_SIMULATION_ENABLED=true
AEGIS_DEFAULT_RATE_LIMIT=120

# Persistence Storage
AEGIS_DB_PATH=:memory:
# AEGIS_LEDGER_PATH=/var/log/aegis/merkle_journal.db
