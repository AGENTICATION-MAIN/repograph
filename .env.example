# Pactum Kernel Environment Configuration
PACTUM_HOST=0.0.0.0
PACTUM_PORT=8000
PACTUM_ENV=development
PACTUM_LOG_LEVEL=INFO

# Cryptographic Secret (Replace with 32+ character high-entropy key in production)
PACTUM_SECRET_KEY=pactum-secret-key-32bytes-for-coasian-barter-kernel

# Kernel Economic Settings
PACTUM_NASH_TOLERANCE=1e-6
PACTUM_MAX_ITERATIONS=100
PACTUM_LEASE_TTL=120.0
PACTUM_ATOMIC_ESCROW=true
